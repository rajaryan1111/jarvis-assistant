# Copy this file to .env and fill in your own values. .env is git-ignored.
# Never commit the real .env file, and never paste keys into issues or chats.
# Every integration is optional: a missing key disables only that feature.

# --- Third-party API credentials -------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
# Groq key, used only by the agent loop when ULTRON_PROVIDER=groq (console.groq.com/keys)
GROQ_API_KEY=your_groq_api_key_here
WEATHER_API_KEY=your_openweather_api_key_here
NEWS_API_KEY=your_newsapi_key_here
CRICKET_API_KEY=your_cricketdata_api_key_here
# Picovoice AccessKey for the wake-word listener (wakeword_listener.py)
PICOVOICE_ACCESS_KEY=your_picovoice_access_key_here

# --- Integration settings ---------------------------------------------------
NEWS_COUNTRY=in
WEATHER_CITY=Delhi

# --- Local HUD/API server -----------------------------------------------------
# The API token is NOT kept here by default: `python -m ultron token init` writes it to
# a 0600 file in the data directory. Uncomment only if you must use an env var instead
# (at least 32 random characters).
# ULTRON_API_TOKEN=
# ULTRON_API_TOKEN_FILE=
# ULTRON_DATA_DIR=            # default: ~/Library/Application Support/Ultron (macOS), ~/.config/ultron (Linux)
# ULTRON_HOST=127.0.0.1       # loopback only; other addresses also need ULTRON_ALLOW_NON_LOOPBACK=1
# ULTRON_PORT=5001
# ULTRON_DEBUG=0              # never enable outside local development
# ULTRON_SESSION_HOURS=12
# ULTRON_BROWSER_APP=Google Chrome
# ULTRON_MEMORY_FILE=         # default: memory.json in the project folder

# --- Agent loop (multi-step requests) ----------------------------------------
# See docs/M2_0_AGENT_LOOP.md, docs/M2_1_REAL_MODEL_VALIDATION.md, docs/M2_2_GROQ_PROVIDER.md
# and docs/M2_3_LOCAL_PROVIDER.md (privacy, cost, live tests). All optional; out-of-range values are clamped.
# ULTRON_AGENT=1                 # 0 = unknown requests use single-shot chat instead
# ULTRON_PROVIDER=openai         # agent-loop model provider: openai (OPENAI_API_KEY), groq (GROQ_API_KEY)
#                                # or ollama (local server, no key)
# ULTRON_CHAT_MODEL=gpt-4.1-mini   # single-shot chat, study plans, knowledge answers (always OpenAI)
# ULTRON_AGENT_MODEL=              # OpenAI agent model; defaults to ULTRON_CHAT_MODEL; must support tool calling
# ULTRON_GROQ_MODEL=openai/gpt-oss-120b  # Groq agent model (ULTRON_PROVIDER=groq); must support tool calling
# ULTRON_GROQ_REASONING_EFFORT=  # low (default for gpt-oss) | medium | high; unset for non-reasoning models
# ULTRON_OLLAMA_MODEL=llama3.1:latest  # Ollama agent model (ULTRON_PROVIDER=ollama); pull it first, tool calling required
# ULTRON_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1  # loopback only (localhost/127.0.0.1/[::1]); other URLs turn the agent off
# ULTRON_LOCAL_ONLY=0            # 1 = refuse remote agent providers (agent off unless ULTRON_PROVIDER=ollama)
# ULTRON_AGENT_MAX_OUTPUT_TOKENS=  # per model call; default 400 (openai) / 1024 (groq, reasoning tokens count; ollama)
# ULTRON_HISTORY=1               # local chat transcript for single-shot replies (data dir, redacted,
#                                # bounded; export/import via `ultron history`); 0 = record nothing
# --- Model racing (`ultron race`, opt-in per invocation; docs/M2_4_MODEL_RACING.md) --------------
# ULTRON_RACE_MODELS=            # default roster: provider[:model] CSV, e.g. groq:llama-3.3-70b,ollama:qwen3:8b
#                                # (unset = every usable configured provider; under ULTRON_LOCAL_ONLY only ollama)
# ULTRON_RACE_MAX_MODELS=3       # racers per race, clamped 2..4; entries beyond the cap are dropped with a warning
# ULTRON_RACE_DEADLINE=45        # overall wall-clock seconds for the race, clamped 5..120
# ULTRON_RACE_TIMEOUT=20         # per-model call seconds, clamped 2..300, never above the deadline
# --- AutoTune (`ultron autotune`, opt-in per invocation; docs/M2_5_AUTOTUNE.md) ------------------
# ULTRON_AUTOTUNE=1              # 0 = refuse `autotune run` (show/route/clear still work on stored data)
# ULTRON_AUTOTUNE_BUDGET=240     # total wall-clock seconds for a tuning run, clamped 30..900
# ULTRON_AUTOTUNE_TASK_DEADLINE=30  # per-task race deadline seconds, clamped 5..180
# ULTRON_AUTOTUNE_TASK_TIMEOUT=20   # per-model call seconds, clamped 2..120
# ULTRON_AUTOTUNE_MIN_PASS=0.5   # routing rule: fraction of a category's tasks a profile must pass (0..1)
# ULTRON_AGENT_MAX_STEPS=6
# ULTRON_AGENT_MAX_TOOL_CALLS=8
# ULTRON_AGENT_MODEL_TIMEOUT=20
# ULTRON_AGENT_TOOL_TIMEOUT=20
# ULTRON_AGENT_MAX_SECONDS=45    # keep below 60 when using the wake-word listener
# ULTRON_AGENT_MAX_CONCURRENT=4

# --- Optional features --------------------------------------------------------
# Path to MediaPipe's hand_landmarker.task model (vision extra, hand gestures)
# ULTRON_HAND_LANDMARKER_MODEL=
# ULTRON_KNOWLEDGE_DIR=
