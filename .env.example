# Copy this file to .env and fill in your own values. .env is git-ignored.
# Never commit the real .env file, and never paste keys into issues or chats.
# Every integration is optional: a missing key disables only that feature.

# --- Third-party API credentials -------------------------------------------
OPENAI_API_KEY=your_openai_api_key_here
WEATHER_API_KEY=your_openweather_api_key_here
NEWS_API_KEY=your_newsapi_key_here
CRICKET_API_KEY=your_cricketdata_api_key_here
# Picovoice AccessKey for the wake-word listener (wakeword_listener.py)
PICOVOICE_ACCESS_KEY=your_picovoice_access_key_here

# --- Integration settings ---------------------------------------------------
NEWS_COUNTRY=in
WEATHER_CITY=Delhi

# --- Local HUD/API server -----------------------------------------------------
# The API token is NOT kept here by default: `python -m ultron token init` writes it to
# a 0600 file in the data directory. Uncomment only if you must use an env var instead
# (at least 32 random characters).
# ULTRON_API_TOKEN=
# ULTRON_API_TOKEN_FILE=
# ULTRON_DATA_DIR=            # default: ~/Library/Application Support/Ultron (macOS), ~/.config/ultron (Linux)
# ULTRON_HOST=127.0.0.1       # loopback only; other addresses also need ULTRON_ALLOW_NON_LOOPBACK=1
# ULTRON_PORT=5001
# ULTRON_DEBUG=0              # never enable outside local development
# ULTRON_SESSION_HOURS=12
# ULTRON_BROWSER_APP=Google Chrome
# ULTRON_MEMORY_FILE=         # default: memory.json in the project folder

# --- Optional features --------------------------------------------------------
# Path to MediaPipe's hand_landmarker.task model (vision extra, hand gestures)
# ULTRON_HAND_LANDMARKER_MODEL=
# ULTRON_KNOWLEDGE_DIR=
