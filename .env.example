# ---------------------------------------------------------------------------
# JARVIS / Ultron configuration - copy to `.env` and edit.
#
# `.env` is git-ignored and must never be committed. Everything below is a
# placeholder: put real values only in `.env`, never in the repository.
#
# The complete list of variables the code reads is longer than this file used to
# be; the defaults below are the real ones (verified against ultron/config.py,
# ultron/agent/*, ultron/voice/*, main.py, vision.py and wakeword_listener.py).
# `python -m ultron doctor` reports what is actually configured.
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------- credentials
# Missing credentials disable the matching feature; they are never fatal.
OPENAI_API_KEY=your_openai_api_key_here
GROQ_API_KEY=your_groq_api_key_here
WEATHER_API_KEY=your_openweather_api_key_here
NEWS_API_KEY=your_newsapi_api_key_here
CRICKET_API_KEY=your_cricketdata_api_key_here
PICOVOICE_ACCESS_KEY=your_picovoice_access_key_here

# ------------------------------------------------------------------- defaults
NEWS_COUNTRY=in
WEATHER_CITY=Delhi

# ------------------------------------------------------------ server / security
# Binds loopback only. Off-loopback needs ULTRON_ALLOW_NON_LOOPBACK=1, and
# ULTRON_DEBUG=1 is refused unless the bind is loopback (the Werkzeug debugger
# can execute code).
ULTRON_HOST=127.0.0.1
ULTRON_PORT=5001
ULTRON_DEBUG=0
ULTRON_ALLOW_NON_LOOPBACK=0
# Comma-separated extra hosts/origins for the HUD (loopback entries only by default).
ULTRON_ALLOWED_HOSTS=
ULTRON_ALLOWED_ORIGINS=
# HUD session lifetime in hours (default 12).
ULTRON_SESSION_HOURS=12

# Auth tokens. Prefer the token files (`python -m ultron token init`); these
# variables override them and are retired by `token rotate`.
ULTRON_API_TOKEN=
ULTRON_API_TOKEN_FILE=
ULTRON_CLIENT_TOKEN=
ULTRON_CLIENT_TOKEN_FILE=

# --------------------------------------------------------------------- storage
# Where memory.json, tasks.json, the transcript, tokens and the knowledge index live.
# Default: ~/.config/ultron on Linux, ~/Library/Application Support/Ultron on macOS.
ULTRON_DATA_DIR=
# Individual overrides (default: alongside the data directory / in the project).
ULTRON_MEMORY_FILE=
ULTRON_HISTORY=1
ULTRON_PROJECT_ROOT=
ULTRON_FACE_DIR=
ULTRON_SCREENSHOT_DIR=
# Browser for `open <url>` (default: the system default).
ULTRON_BROWSER_APP=

# ---------------------------------------------------------------- agent limits
# Every bound here exists to keep one turn finite. A failed provider call is
# never retried (max_retries=0), so a consequential action cannot repeat itself.
ULTRON_AGENT=1
ULTRON_PROVIDER=openai
ULTRON_AGENT_MODEL=gpt-4.1-mini
ULTRON_AGENT_MODEL_TIMEOUT=20
ULTRON_AGENT_TOOL_TIMEOUT=20
ULTRON_AGENT_MAX_STEPS=6
ULTRON_AGENT_MAX_TOOL_CALLS=8
ULTRON_AGENT_MAX_OUTPUT_TOKENS=400
ULTRON_AGENT_MAX_SECONDS=45
ULTRON_AGENT_MAX_CONCURRENT=4
ULTRON_LOCAL_ONLY=0

# Local (Ollama) provider.
ULTRON_OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
ULTRON_OLLAMA_MODEL=
ULTRON_GROQ_MODEL=
ULTRON_GROQ_REASONING_EFFORT=
ULTRON_CHAT_MODEL=

# --------------------------------------------------------- optional subsystems
# All three are off unless explicitly enabled, and each names its own advisers.
ULTRON_ENSEMBLE=0
ULTRON_ENSEMBLE_ADVISERS=
ULTRON_ENSEMBLE_MAX_ADVISERS=3
ULTRON_ENSEMBLE_SYNTHESIS=
ULTRON_RACE_MODELS=
ULTRON_RACE_DEADLINE=
ULTRON_RACE_TIMEOUT=
ULTRON_RACE_MAX_MODELS=
ULTRON_AUTOTUNE=0
ULTRON_AUTOTUNE_BUDGET=
ULTRON_AUTOTUNE_TASK_TIMEOUT=
ULTRON_AUTOTUNE_TASK_DEADLINE=
ULTRON_AUTOTUNE_MIN_PASS=
ULTRON_ROUTER=0
ULTRON_ROUTER_MAX_AGE_DAYS=
ULTRON_ROUTER_MIN_PASS=

# ------------------------------------------------------------------- voice I/O
# Recognition locale: en (default, historical behaviour) | hi | hinglish | auto.
# There is no Hinglish locale: romanised Hindi is recognised with en-IN and
# classified from the transcript. A spoken "switch to hindi" changes it live.
ULTRON_VOICE_LANGUAGE=en
# How much a *spoken* request may do. Voice can never approve a confirmation.
ULTRON_VOICE_TRUST=observe
# Seconds the assistant listens for one command before giving up (default 6).
ULTRON_VOICE_COMMAND_TIMEOUT=
# Seconds to wait before retrying when there is no usable microphone at all. Without
# this a missing device or a missing voice extra spins the CPU (measured at ~39,000
# turns a second). A normal silence/timeout retries immediately, with no pause.
ULTRON_VOICE_UNAVAILABLE_BACKOFF=

# ------------------------------------------------------------------ wake word
# The wake word is "Ultron". Ultron is NOT a built-in Porcupine keyword, so it needs a
# custom model: train one free at https://console.picovoice.ai/ (Porcupine > custom
# keywords), download the .ppn, and either:
#   * save it as ultron.ppn in the project folder, or
#   * put its full path here (this wins over the default location).
# PICOVOICE_ACCESS_KEY (above) is required alongside it. Neither is ever committed.
# Run `python -m ultron voice-status` to see exactly which of the three is missing.
ULTRON_WAKE_MODEL=

# ----------------------------------------------------------------- live testing
# Opt-in: these make the suite call real providers and spend money.
ULTRON_LIVE_OPENAI=0
ULTRON_LIVE_GROQ=0
ULTRON_LIVE_OLLAMA=0
